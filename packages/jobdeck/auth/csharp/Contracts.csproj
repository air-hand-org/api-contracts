<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <AssemblyName>Jobdeck.Auth.Contracts</AssemblyName>
    <PackageId>Jobdeck.Auth.Contracts</PackageId>
    <Version>1.3.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2"/>
    <PackageReference Include="Grpc.Net.Common" Version="2.84.0"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath=""/>
    <None Include="../third_party/**/*" Pack="true" PackagePath="third_party/"/>
  </ItemGroup>
</Project>
