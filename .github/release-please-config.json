{
  "separate-pull-requests": true,
  "always-update": true,
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "draft": false,
  "force-tag-creation": true,
  "extra-files": [
    {
      "type": "xml",
      "path": "csharp/Contracts.csproj",
      "xpath": "//Version"
    }
  ],
  "packages": {
    "packages/jobdeck/auth": {
      "package-name": "jobdeck-auth",
      "component": "packages/jobdeck/auth",
      "release-as": "1.3.1"
    },
    "packages/jobdeck/job": {
      "package-name": "jobdeck-job",
      "component": "packages/jobdeck/job",
      "release-as": "1.2.1"
    }
  }
}
